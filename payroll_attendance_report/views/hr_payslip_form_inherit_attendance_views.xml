<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_hr_payslip_form_inherit_attendance" model="ir.ui.view">
    <field name="name">hr.payslip.form.inherit.attendance</field>
    <field name="model">hr.payslip</field>
    <field name="inherit_id" ref="payroll.hr_payslip_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button
                    name="%(action_hr_payslip_attendance_report_template_wizard)d"
                    string="Print Attendance"
                    type="action"
                    context="{'default_payslip_id': id}"
                    attrs="{'invisible': [('state', '!=', 'done')]}"
                />
      </xpath>
    </field>
  </record>
</odoo>
