<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="action_report_payslip_attendance_br" model="ir.actions.report">
    <field name="name">Attendance Sheet</field>
    <field name="model">hr.payslip</field>
    <field name="report_type">qweb-pdf</field>
    <field
            name="report_name"
        >payroll_attendance_report.report_payslip_attendance_br</field>
    <field
            name="report_file"
        >payroll_attendance_report.report_payslip_attendance_br</field>
    <field name="print_report_name">
      'Attendance - %s' % (object.employee_id.name)
    </field>
    <field name="binding_model_id" ref="payroll.model_hr_payslip" />
    <field name="binding_type">report</field>
  </record>
</odoo>
