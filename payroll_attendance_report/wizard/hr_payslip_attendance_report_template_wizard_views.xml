<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record
        id="action_hr_payslip_attendance_report_template_wizard"
        model="ir.actions.act_window"
    >
    <field name="name">Select Attendance Template</field>
    <field name="res_model">hr.payslip.attendance.report.template.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <record
        id="view_hr_payslip_attendance_report_template_wizard_form"
        model="ir.ui.view"
    >
    <field name="name">hr.payslip.attendance.report.template.wizard.form</field>
    <field name="model">hr.payslip.attendance.report.template.wizard</field>
    <field name="arch" type="xml">
      <form string="Select Attendance Template">
        <group>
          <field name="template_id" options="{'no_create': True}" />
          <field name="payslip_id" invisible="1" />
          <field name="date_from" />
          <field name="date_to" />
        </group>
        <footer>
        <button string="Print" name="action_print" type="object" class="btn-primary" />
          <button string="Cancel" class="btn-secondary" special="cancel" />
        </footer>
      </form>
    </field>
  </record>
</odoo>
