<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="action_hr_payslip_run_report_template" model="ir.actions.act_window">
    <field name="name">Payslip Batch Templates</field>
    <field name="res_model">hr.payslip.run.report.template</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Create your first payslip batch conference template!
      </p>
      <p>
        These templates define the layout of the batch conference report
        (employees, bank data and financial totals).
      </p>
    </field>
  </record>

  <record id="view_hr_payslip_run_report_template_tree" model="ir.ui.view">
    <field name="name">hr.payslip.run.report.template.tree</field>
    <field name="model">hr.payslip.run.report.template</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name" />
        <field name="active" widget="boolean_toggle" />
      </tree>
    </field>
  </record>

  <record id="view_hr_payslip_run_report_template_form" model="ir.ui.view">
    <field name="name">hr.payslip.run.report.template.form</field>
    <field name="model">hr.payslip.run.report.template</field>
    <field name="arch" type="xml">
      <form string="Payslip Batch Conference Template">
        <header>
          <button
                        name="action_duplicate"
                        string="Duplicate"
                        type="object"
                        class="oe_highlight"
                    />
        </header>
        <sheet>
          <group>
            <group>
              <field name="name" />
              <field name="active" />
            </group>
            <group>
              <field name="report_template_id" />
            </group>
          </group>
          <group>
            <field name="description" placeholder="Description of this template..." />
          </group>
          <notebook>
            <page string="Help (QWeb)" name="help">
              <div style="margin-top: 4px;">
                <h3>Available variables in conference templates (QWeb)</h3>
                <p>
                  In a QWeb template you can write any HTML code using QWeb
                  expressions.
                </p>
                <p>
                  The following objects and variables are available:
                </p>
                <ul>
                  <li>
                    <code>run</code> : current payslip batch
                    (<code>hr.payslip.run</code>)
                  </li>
                  <li>
                    <code>company</code> : company (<code>res.company</code>)
                  </li>
                  <li>
                    <code>data</code> : result of
                    <code>run._get_conference_data()</code> (dict)
                  </li>
                  <li>
                    <code>lines</code> : list of dictionaries with employee,
                    bank and financial information
                  </li>
                  <li>
                    <code>o</code> : alias for <code>run</code>
                  </li>
                </ul>
              </div>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_hr_payslip_run_report_template_search" model="ir.ui.view">
    <field name="name">hr.payslip.run.report.template.search</field>
    <field name="model">hr.payslip.run.report.template</field>
    <field name="arch" type="xml">
      <search string="Payslip Batch Templates">
        <field name="name" />
        <filter string="Active" name="active" domain="[('active', '=', True)]" />
        <filter string="Inactive" name="inactive" domain="[('active', '=', False)]" />
      </search>
    </field>
  </record>

  <menuitem
        id="menu_hr_payslip_run_report_template_root"
        name="Payslip Batch Templates"
        parent="payroll.payroll_menu_configuration"
        action="action_hr_payslip_run_report_template"
        sequence="70"
    />
</odoo>
