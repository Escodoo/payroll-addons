<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!-- Wizard for selecting payslip template -->
  <record id="action_hr_payslip_report_template_wizard" model="ir.actions.act_window">
    <field name="name">Select Payslip Template</field>
    <field name="res_model">hr.payslip.report.template.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <record id="view_hr_payslip_report_template_wizard_form" model="ir.ui.view">
    <field name="name">hr.payslip.report.template.wizard.form</field>
    <field name="model">hr.payslip.report.template.wizard</field>
    <field name="arch" type="xml">
      <form string="Select Payslip Template">
        <group>
          <field name="template_id" options="{'no_create': True}" />
        </group>
        <footer>
          <button
                        string="Print"
                        name="action_print"
                        type="object"
                        class="btn-primary"
                    />
          <button string="Cancel" class="btn-secondary" special="cancel" />
        </footer>
      </form>
    </field>
  </record>
</odoo>
